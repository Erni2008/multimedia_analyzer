APP_NAME=Multimedia Analyzer
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/multimedia_analyzer
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=250
DEFAULT_ALERT_ENTITIES=OpenAI,Microsoft,Google,Amazon
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=1
WHISPER_CACHE_DIR=storage/whisper-cache
